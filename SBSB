  function drawRider(p, horseColor, riderColor, name, isPlayer, gaitPhase = 0) {
    if (!p) return;
    const s = Math.max(.55, Math.min(32, p.scale));
    const x = p.x, y = p.y;
    ctx.save();
    // 네 다리를 서로 다른 박자로 흔들어 달리는 말의 질주 동작을 표현합니다.
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    const legs = [
      { hip: -.53, phase: gaitPhase, near: false },
      { hip: -.34, phase: gaitPhase + Math.PI * .92, near: true },
      { hip: .37, phase: gaitPhase + Math.PI, near: false },
      { hip: .55, phase: gaitPhase + Math.PI * 1.88, near: true }
    ];
    for (const leg of legs) {
      const swing = Math.sin(leg.phase) * .24;
      const lift = Math.max(0, Math.cos(leg.phase)) * .16;
      const hipX = x + leg.hip * s;
      const hipY = y - .53 * s;
      const kneeX = hipX + (leg.hip < 0 ? -.09 : .08) * s + swing * s * .55;
      const kneeY = y - (.28 + lift * .45) * s;
      const hoofX = hipX + swing * s;
      const hoofY = y - lift * s;
      ctx.strokeStyle = leg.near ? '#38251b' : 'rgba(56,37,27,.72)';
      ctx.lineWidth = Math.max(1.8, s * (leg.near ? .16 : .12));
      ctx.beginPath(); ctx.moveTo(hipX, hipY); ctx.lineTo(kneeX, kneeY); ctx.lineTo(hoofX, hoofY); ctx.stroke();
      ctx.strokeStyle = '#241a15'; ctx.lineWidth = Math.max(1.5, s * .11);
      ctx.beginPath(); ctx.moveTo(hoofX - .07*s, hoofY); ctx.lineTo(hoofX + .08*s, hoofY); ctx.stroke();
    }
    // 말 몸통과 목
    ctx.fillStyle = horseColor; ctx.beginPath(); ctx.ellipse(x, y - .72*s, .86*s, .48*s, -.05, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.moveTo(x + .35*s, y - .88*s); ctx.lineTo(x + .55*s, y - 1.65*s); ctx.lineTo(x + .83*s, y - 1.77*s); ctx.lineTo(x + .7*s, y - .95*s); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.ellipse(x + .83*s, y - 1.73*s, .31*s, .22*s, -.15, 0, Math.PI*2); ctx.fill();
    ctx.strokeStyle = '#2e2119'; ctx.lineWidth = Math.max(1.5, .13*s); ctx.beginPath(); ctx.moveTo(x + .3*s, y - 1.05*s); ctx.quadraticCurveTo(x + .55*s, y - 1.45*s, x + .73*s, y - 1.78*s); ctx.stroke();
    // 기수
    ctx.fillStyle = riderColor; ctx.beginPath(); ctx.ellipse(x - .04*s, y - 1.48*s, .37*s, .43*s, -.12, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#38241a'; ctx.beginPath(); ctx.arc(x - .08*s, y - 2.03*s, .25*s, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#f3d6a0'; ctx.fillRect(x - .31*s, y - 1.62*s, .57*s, .12*s);
    if (name && p.depth < 180) {
      ctx.textAlign = 'center'; ctx.font = `bold ${Math.max(9, Math.min(14, s*1.15))}px sans-serif`;
      ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(50,27,14,.75)'; ctx.strokeText(name, x, y - 2.35*s);
      ctx.fillStyle = '#fff1ca'; ctx.fillText(name, x, y - 2.35*s);
    }
    if (isPlayer) {
      ctx.strokeStyle = 'rgba(255,237,189,.8)'; ctx.lineWidth = Math.max(1, s*.1); ctx.beginPath(); ctx.arc(x, y - 1.1*s, .95*s, Math.PI, Math.PI*2); ctx.stroke();
    }
    ctx.restore();
  }

  function drawAiSkillEffects(rider, camera, riderPoint) {
    if (rider.sprinting) {
      // 질주 중 말 뒤로 흩날리는 모래먼지
      for (let i = 0; i < 3; i++) {
