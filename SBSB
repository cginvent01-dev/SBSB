    ctx.fillStyle = '#f8df9e'; ctx.beginPath(); ctx.arc(anchor.x,anchor.y,5,0,Math.PI*2); ctx.fill(); ctx.restore();
  }

  function drawFirstPersonHorse() {
    const center = W * .5;
    const y = H;
    ctx.save();
    // 갈기와 말의 머리가 화면 아래쪽에 보이도록 표현
    ctx.fillStyle = '#39251c';
    ctx.beginPath(); ctx.moveTo(center-W*.18,y); ctx.quadraticCurveTo(center-W*.12,y-H*.22,center-W*.055,y-H*.26); ctx.quadraticCurveTo(center,y-H*.22,center+W*.055,y-H*.26); ctx.quadraticCurveTo(center+W*.13,y-H*.19,center+W*.18,y); ctx.closePath(); ctx.fill();
    ctx.fillStyle = '#7b4a30';
    ctx.beginPath(); ctx.moveTo(center-W*.13,y); ctx.quadraticCurveTo(center-W*.09,y-H*.16,center-W*.045,y-H*.21); ctx.quadraticCurveTo(center,y-H*.18,center+W*.045,y-H*.21); ctx.quadraticCurveTo(center+W*.09,y-H*.16,center+W*.13,y); ctx.closePath(); ctx.fill();
    // 귀
    ctx.fillStyle = '#513323';
    ctx.beginPath(); ctx.moveTo(center-W*.09,y-H*.18); ctx.lineTo(center-W*.12,y-H*.34); ctx.lineTo(center-W*.035,y-H*.25); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(center+W*.09,y-H*.18); ctx.lineTo(center+W*.12,y-H*.34); ctx.lineTo(center+W*.035,y-H*.25); ctx.closePath(); ctx.fill();
    ctx.fillStyle = '#c18a62';
    ctx.beginPath(); ctx.moveTo(center-W*.09,y-H*.205); ctx.lineTo(center-W*.105,y-H*.31); ctx.lineTo(center-W*.055,y-H*.25); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(center+W*.09,y-H*.205); ctx.lineTo(center+W*.105,y-H*.31); ctx.lineTo(center+W*.055,y-H*.25); ctx.closePath(); ctx.fill();
    // 갈기 결
