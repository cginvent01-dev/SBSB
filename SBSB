        gradient.addColorStop(0, '#f4f4f4'); gradient.addColorStop(.3, '#b9bdc2'); gradient.addColorStop(.72, '#707780'); gradient.addColorStop(1, '#343a42');
        ctx.fillStyle = gradient; ctx.beginPath(); ctx.arc(ballPoint.x, ballPoint.y, radius, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = 'rgba(238,242,246,.95)'; ctx.lineWidth = Math.max(1, radius * .08);
        ctx.beginPath(); ctx.arc(ballPoint.x, ballPoint.y, radius * .72, -.8, 1.2); ctx.stroke();
