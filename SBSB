      const rootX = center + side * W * .075;
      const rootY = y - H * .035;
      const kneeX = rootX + side * W * (.035 + swing * .025);
      const kneeY = y - H * (.105 + lift * .035);
      const hoofX = rootX + side * W * (.07 + swing * .045);
