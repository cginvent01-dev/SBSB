      ctx.strokeStyle = '#3a261c'; ctx.lineWidth = Math.max(8, W*.018);
      ctx.beginPath(); ctx.moveTo(rootX, rootY); ctx.quadraticCurveTo(kneeX - side*W*.012, kneeY, kneeX, kneeY); ctx.lineTo(hoofX, hoofY); ctx.stroke();
      ctx.strokeStyle = '#865233'; ctx.lineWidth = Math.max(5, W*.011);
      ctx.beginPath(); ctx.moveTo(rootX - side*W*.003, rootY); ctx.quadraticCurveTo(kneeX - side*W*.012, kneeY, kneeX, kneeY); ctx.lineTo(hoofX, hoofY); ctx.stroke();
      ctx.fillStyle = '#302019'; ctx.beginPath(); ctx.ellipse(hoofX, hoofY, Math.max(7,W*.014), Math.max(4,H*.009), -.1*side, 0, Math.PI*2); ctx.fill();
