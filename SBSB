  // T 스킬은 플레이어 전용입니다. 공룡은 카메라 연출을 바꾸지 않고, 플레이어가 보고 있는
  // 사막 코스 위에 실제 월드 오브젝트로 등장해 AI를 쫓아갑니다.
  function activateDino() {
    if (dimension.active) { toast('다른 차원에는 AI가 없어서 공룡을 부를 수 없어요.'); return; }
    if (phase !== 'racing' || cooldowns.dino > 0 || dinoAttack) return;
    const targets = ai.filter(rider => !rider.eliminated && !rider.beingEaten && !rider.beingChased && !rider.beingPillarStruck);
    if (!targets.length) { toast('공룡이 잡아먹을 AI가 없어요!'); return; }

    // 플레이어 앞쪽에서 가장 가까운 AI를 목표로 합니다. 뒤에 있는 AI를 고르면
    // 고정된 플레이어 시야 밖에서 먹는 일이 생기므로, 앞에 AI가 있을 때만 소환합니다.
    const ahead = targets.filter(rider => rider.z > player.z + 5);
    if (!ahead.length) { toast('앞쪽에 AI가 있을 때 공룡을 소환할 수 있어요!'); return; }
    ahead.sort((a, b) => a.z - b.z);
    const target = ahead[0];

    // 플레이어가 보던 코스 중앙에 공룡이 튀어나옵니다. 카메라 위치와 방향은 바뀌지 않습니다.
    const spawnZ = Math.max(player.z + 3.5, Math.min(player.z + 20, target.z - 25));
    cooldowns.dino = 30;
    target.beingChased = true;
    dinoAttack = {
      target,
      x: trackCenter(spawnZ),
      z: spawnZ,
      elapsed: 0,
      gait: 0,
      phase: 'emerge',
      emergeTimer: 0.48,
