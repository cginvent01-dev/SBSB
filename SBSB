  function update(dt) {
    if (timeStopShoutTimer > 0) {
      timeStopShoutTimer = Math.max(0, timeStopShoutTimer - dt);
      if (timeStopShoutTimer <= 0) $('theWorldShout').classList.remove('show');
    }
    if (dimensionShoutTimer > 0) {
      dimensionShoutTimer = Math.max(0, dimensionShoutTimer - dt);
      if (dimensionShoutTimer <= 0) $('dimensionShout').classList.remove('show');
    }
    if (loveTrainShoutTimer > 0 && !timeStop.active) {
      loveTrainShoutTimer = Math.max(0, loveTrainShoutTimer - dt);
      if (loveTrainShoutTimer <= 0) $('loveTrainShout').classList.remove('show');
    }
    if (showMessageTimer > 0) {
      showMessageTimer -= dt;
      if (showMessageTimer <= 0) $('toast').style.opacity = '0';
    }
    if (phase === 'countdown') {
      countdown -= dt;
      const shown = Math.max(1, Math.ceil(countdown));
      $('raceMessage').textContent = countdown > 0 ? String(shown) : '출발!';
      if (countdown <= -0.65) { phase = 'racing'; $('raceMessage').textContent = ''; toast('경주 시작! 완주선을 향해 달리세요.'); }
      return;
    }
    if (phase !== 'racing') return;

    const worldDt = timeStop.active ? 0 : dt;
    raceTime += worldDt;
    for (const k of Object.keys(cooldowns)) {
      // X 스킬 쿨타임은 다른 차원 안에서는 멈추고, 현실로 돌아온 뒤부터 감소합니다.
      if (k === 'dimension' && dimension.active) continue;
      cooldowns[k] = Math.max(0, cooldowns[k] - dt);
    }
    if (timeStop.active) {
      timeStop.timeLeft = Math.max(0, timeStop.timeLeft - dt);
      $('timeStopTimer').textContent = `${timeStop.timeLeft.toFixed(1)}초 · 나만 움직일 수 있어요`;
      if (timeStop.timeLeft <= 0) {
        timeStop.active = false;
        $('timeStopBanner').style.display = 'none';
        toast('시간이 다시 흐르기 시작했어요!');
      }
    }
    if (dimension.active) {
      dimension.timeLeft = Math.max(0, dimension.timeLeft - dt);
      dimension.elapsed += dt;
      $('dimensionTimer').textContent = `${dimension.timeLeft.toFixed(1)}초 남음 · AI는 현실에서 경주 중`;
      if (dimension.timeLeft <= 0) {
        dimension.active = false;
        $('dimensionBanner').style.display = 'none';
        toast(`현실로 복귀! 차원에서 ${Math.max(0, player.z - dimension.entryZ).toFixed(1)}m 이동했어요.`);
      }
    }
    if (worldDt > 0 && dinoAttack && !dimension.active) {
      dinoAttack.elapsed += worldDt;
      dinoAttack.gait += worldDt * 13;
      const target = dinoAttack.target;
      if (target.eliminated) { target.beingChased = false; target.beingEaten = false; dinoAttack = null; }
      else if (dinoAttack.phase === 'emerge') {
        // 공룡이 코스 바닥에서 튀어나오는 짧은 등장 동작입니다. 플레이어 시점은 그대로입니다.
        dinoAttack.emergeTimer = Math.max(0, dinoAttack.emergeTimer - dt);
        if (dinoAttack.emergeTimer <= 0) dinoAttack.phase = 'run';
      } else if (dinoAttack.phase === 'run') {
        // 코스의 중앙선을 따라 달려가 목표 AI를 따라잡습니다.
        const dinoRunSpeed = 54;
        const catchLine = target.z - 2.2;
        dinoAttack.z = Math.min(catchLine, dinoAttack.z + dinoRunSpeed * dt);
        dinoAttack.z = Math.max(0, dinoAttack.z);
        dinoAttack.x = trackCenter(dinoAttack.z);
        if (dinoAttack.z >= target.z - 2.25 || target.z <= dinoAttack.z + 2.25) {
          dinoAttack.z = Math.max(0, target.z - 2.0);
          dinoAttack.x = trackCenter(dinoAttack.z);
          dinoAttack.phase = 'eat';
          dinoAttack.eatTimer = 1.65;
          target.beingChased = false;
          target.beingEaten = true;
          toast('공룡이 AI를 따라잡았어요!');
        }
      } else if (dinoAttack.phase === 'eat') {
        dinoAttack.eatTimer = Math.max(0, dinoAttack.eatTimer - dt);
        dinoAttack.z = Math.max(0, target.z - 1.9);
        dinoAttack.x = trackCenter(dinoAttack.z);
        if (dinoAttack.eatTimer <= 0) {
          target.beingEaten = false;
          target.eliminated = true;
          dinoAttack = null;
          toast('Dio! 공룡이 AI 기수 한 명을 잡아먹었어요!');
        }
      }
    }
    player.slowTimer = Math.max(0, player.slowTimer - dt);
    if (player.slowTimer <= 0) player.slowReason = '';

    const forward = (keys.has('KeyW') ? 1 : 0) - (keys.has('KeyS') ? 1 : 0);
    const side = (keys.has('KeyD') ? 1 : 0) - (keys.has('KeyA') ? 1 : 0);
    const sprintHeld = keys.has('ShiftLeft') || keys.has('ShiftRight');
    const sprintWanted = sprintHeld && forward > 0 && !player.staminaRecovering && player.stamina > 0.001;
    if (sprintWanted) {
      player.stamina = Math.max(0, player.stamina - dt);
      if (player.stamina <= 0.001) player.staminaRecovering = true;
    } else {
      player.stamina = Math.min(30, player.stamina + dt * 2);
      if (player.stamina >= 29.999) {
        player.stamina = 30;
        player.staminaRecovering = false;
      }
    }

    let dx = 0, dz = 0;
    if (forward || side) {
      let f = forward, s = side;
      const norm = Math.hypot(f, s) || 1;
      f /= norm; s /= norm;
      const slowMultiplier = player.slowTimer > 0 ? 0.55 : 1;
      const dimensionMultiplier = dimension.active ? 1.40 : 1;
      const forwardSpeed = (f < 0 ? 15 : (sprintWanted ? 35 : 23)) * slowMultiplier * dimensionMultiplier;
      const sideSpeed = 14.5 * slowMultiplier * dimensionMultiplier;
      dx = (Math.sin(player.yaw) * f * forwardSpeed + Math.cos(player.yaw) * s * sideSpeed) * dt;
      dz = (Math.cos(player.yaw) * f * forwardSpeed - Math.sin(player.yaw) * s * sideSpeed) * dt;
    }

    if (rope) {
      rope.time -= dt;
      const rx = rope.x - player.x, rz = rope.z - player.z;
      const distance = Math.hypot(rx, rz);
      const pull = Math.min(distance, 17 * dt);
      if (distance > 0.001) { dx += rx / distance * pull; dz += rz / distance * pull; }
      if (distance < 2 || rope.time <= 0) { rope = null; toast('밧줄 이동 완료!'); }
    }
    player.prevX = player.x; player.prevZ = player.z;
    player.x += dx; player.z += dz;
    clampToTrack();
    player.speed = dt > 0 ? Math.hypot(dx, dz) / dt : 0;
    // 더월드 중에도 플레이어는 움직이므로 말의 다리 애니메이션은 현실 시간으로 계속 진행합니다.
    player.gaitTime += dt * (player.speed > 0.5 ? 11 : 1.8);

    if (player.y > 0 || player.vy > 0) {
      player.y += player.vy * dt;
      player.vy -= GRAVITY * dt;
      if (player.y < 0) { player.y = 0; player.vy = 0; }
    }

    if (steelBall) {
      if (steelBall.state === 'orbit') {
        steelBall.angle += worldDt * 5.1;
        steelBall.timer -= worldDt;
        steelBall.lastX = player.x + Math.cos(steelBall.angle) * 4.3;
        steelBall.lastZ = player.z + Math.sin(steelBall.angle) * 4.3;
        steelBall.lastY = player.y + 2.6 + Math.sin(steelBall.angle * 1.8) * .55;
        if (steelBall.timer <= 0) { steelBall.state = 'return'; steelBall.returnTimer = .65; toast('철구가 돌아옵니다!'); }
      } else {
        steelBall.returnTimer -= worldDt;
        if (steelBall.returnTimer <= 0) steelBall = null;
      }
    }

    if (worldDt > 0) ai.forEach((rider, i) => {
      rider.pillarHitFlash = Math.max(0, (rider.pillarHitFlash || 0) - worldDt);
      // 다른 차원에서도 AI는 멈추지 않고 평소처럼 경주와 스킬을 계속합니다.
      if (rider.eliminated || rider.beingEaten || rider.beingPillarStruck) return;
      rider.prevX = Number.isFinite(rider.x) ? rider.x : trackCenter(rider.z) + rider.lane;
      rider.prevZ = rider.z;
      // AI 기수도 플레이어처럼 질주 스태미나를 쓰고 회복합니다.
      rider.jumpCooldown = Math.max(0, rider.jumpCooldown - worldDt);
      rider.ropeCooldown = Math.max(0, rider.ropeCooldown - worldDt);
      rider.ballCooldown = Math.max(0, rider.ballCooldown - worldDt);
      rider.slowTimer = Math.max(0, rider.slowTimer - worldDt);
      rider.skillThink -= dt;

      if (rider.stamina <= 0.001 && !rider.staminaRecovering) rider.staminaRecovering = true;
      if (rider.staminaRecovering) {
        rider.sprinting = false;
        rider.stamina = Math.min(30, rider.stamina + worldDt * 2);
        if (rider.stamina >= 29.999) {
          rider.stamina = 30;
          rider.staminaRecovering = false;
          rider.sprintPause = 2;
          rider.sprintBurst = 4.5 + Math.random() * 4;
        }
      } else if (rider.sprintPause > 0) {
        rider.sprintPause = Math.max(0, rider.sprintPause - worldDt);
        rider.sprinting = false;
        rider.stamina = Math.min(30, rider.stamina + worldDt * 2);
      } else {
        rider.sprinting = rider.sprintBurst > 0;
        if (rider.sprinting) {
          rider.sprintBurst -= dt;
          rider.stamina = Math.max(0, rider.stamina - worldDt);
          if (rider.stamina <= 0.001) rider.staminaRecovering = true;
          if (rider.sprintBurst <= 0) {
            rider.sprintBurst = 4.5 + Math.random() * 4;
            rider.sprintPause = 3.5 + Math.random() * 3.5;
          }
        } else {
          rider.stamina = Math.min(30, rider.stamina + worldDt * 2);
          rider.sprintPause = 2 + Math.random() * 2;
        }
      }

      // C, F, G 스킬을 상황에 맞춰 번갈아 사용합니다.
      if (rider.skillThink <= 0) {
        const readySkills = [];
        if (rider.jumpCooldown <= 0) readySkills.push('jump');
        if (rider.ropeCooldown <= 0) readySkills.push('rope');
        if (rider.ballCooldown <= 0) readySkills.push('ball');
        if (readySkills.length) {
          const skill = readySkills[Math.floor(Math.random() * readySkills.length)];
          if (skill === 'jump') {
            rider.jumpCooldown = 10;
            if (rider.y <= 0.02) rider.vy = 13.5;
            rider.jumpFlash = .65;
          } else if (skill === 'rope') {
            rider.ropeCooldown = 10;
            rider.ropeBoost = .9;
            rider.ropeEffect = .9;
          } else {
            rider.ballCooldown = 10;
            rider.ballTimer = 5;
            rider.ballAngle = Math.random() * Math.PI * 2;
            rider.ballHitTargets = new Set();
          }
        }
        rider.skillThink = 1.5 + Math.random() * 2.2;
      }

      rider.ropeBoost = Math.max(0, rider.ropeBoost - worldDt);
      rider.ropeEffect = Math.max(0, rider.ropeEffect - worldDt);
      rider.jumpFlash = Math.max(0, (rider.jumpFlash || 0) - worldDt);
      if (rider.ballTimer > 0) {
        rider.ballTimer = Math.max(0, rider.ballTimer - worldDt);
        rider.ballAngle += dt * 5.4;
      }
      if (rider.y > 0 || rider.vy > 0) {
        rider.y += rider.vy * worldDt;
        rider.vy -= GRAVITY * worldDt;
        if (rider.y < 0) { rider.y = 0; rider.vy = 0; }
      }

      const sprintMultiplier = rider.sprinting ? 1.34 : 1;
      const ropeMultiplier = rider.ropeBoost > 0 ? 1.58 : 1;
      const hitSlowMultiplier = rider.slowTimer > 0 ? 0.55 : 1;
      const aiSpeed = rider.speed * sprintMultiplier * ropeMultiplier * hitSlowMultiplier;
      if (rider.z < FINISH) rider.z = Math.min(FINISH, rider.z + aiSpeed * worldDt);
      rider.x = trackCenter(rider.z) + rider.lane + Math.sin(raceTime * 1.05 + i) * .55;
    });

    updateLoveTrain(worldDt);
    if (worldDt > 0) applySteelBallCollisions();
    // 선인장은 고정 장애물이므로 멈춘 시간에도 움직이는 플레이어에게만 충돌합니다.
    applyCactusCollisions(timeStop.active);

    if (player.z >= FINISH - .01) finishRace();
    updateHud();
  }

  function updateLoveTrain(dt) {
    const attack = loveTrainAttack;
    if (!attack) return;
    attack.elapsed += dt;
    attack.angle += dt * 4.6;
    for (const impact of attack.impacts) impact.timer = Math.max(0, impact.timer - dt);
    attack.impacts = attack.impacts.filter(impact => impact.timer > 0);

    if (attack.target.eliminated && attack.phase !== 'finish') {
      attack.target.beingPillarStruck = false;
      loveTrainAttack = null;
      return;
    }

    if (attack.phase === 'orbit') {
      attack.orbitTime = Math.max(0, attack.orbitTime - dt);
      if (attack.orbitTime <= 0) {
        const target = attack.target;
        if (!target || target.eliminated) { loveTrainAttack = null; return; }
        attack.phase = 'rain';
        attack.baseZ = target.z;
        attack.laneOffset = target.x - trackCenter(target.z);
        attack.strikeElapsed = 0;
        attack.strikeIndex = 0;
        target.beingPillarStruck = true;
        toast(`${target.name}에게 황금 기둥이 떨어집니다!`);
      }
    } else if (attack.phase === 'rain') {
      attack.strikeElapsed += dt;
      const fallDuration = .42;
      const cycleDuration = .76;
      if (!attack.currentHit && attack.strikeElapsed >= fallDuration) {
        attack.currentHit = true;
        const offset = [-4.2, 0, 4.2][attack.strikeIndex];
        const strikeZ = Math.max(0, Math.min(FINISH, attack.baseZ + offset));
        const strikeX = trackCenter(strikeZ) + attack.laneOffset;
        attack.impacts.push({ x: strikeX, z: strikeZ, timer: .58, maxTimer: .58 });
        attack.target.pillarHitFlash = .58;
        toast(`러브트레인! 황금 기둥 ${attack.strikeIndex + 1}/3!`);
        if (attack.strikeIndex === 2) {
          attack.target.beingPillarStruck = false;
          attack.target.eliminated = true;
          attack.target.eliminatedByLoveTrain = true;
          attack.phase = 'finish';
          attack.finishTimer = .85;
          toast(`${attack.target.name}이(가) 황금 기둥 세 번을 맞고 탈락했어요!`);
        }
      }
      if (attack.phase === 'rain' && attack.strikeElapsed >= cycleDuration) {
        attack.strikeElapsed -= cycleDuration;
        attack.strikeIndex++;
        attack.currentHit = false;
      }
    } else if (attack.phase === 'finish') {
      attack.finishTimer = Math.max(0, attack.finishTimer - dt);
      if (attack.finishTimer <= 0 && attack.impacts.length === 0) loveTrainAttack = null;
    }
  }

  // 선인장에 닿으면 플레이어와 AI 모두 1초 동안 이동 속도가 느려집니다.
  // 작은 충돌 반경을 사용해 선인장 그림 가장자리에 스치는 정도로는 맞지 않습니다.
  function applyCactusCollisions(freezeAI = false) {
    const hit = (racer, onHit) => {
      for (let i = 0; i < cactusObstacles.length; i++) {
        if (racer.hitCacti.has(i)) continue;
        const cactus = cactusObstacles[i];
        // 프레임 사이를 빠르게 지나가도 놓치지 않도록 이동 선분에서 가장 가까운 지점을 검사합니다.
        const sx = Number.isFinite(racer.prevX) ? racer.prevX : racer.x;
        const sz = Number.isFinite(racer.prevZ) ? racer.prevZ : racer.z;
        const vx = racer.x - sx;
        const vz = racer.z - sz;
        const lengthSq = vx * vx + vz * vz;
        const t = lengthSq > 0 ? Math.max(0, Math.min(1, ((cactus.x - sx) * vx + (cactus.z - sz) * vz) / lengthSq)) : 1;
        const dx = sx + vx * t - cactus.x;
        const dz = sz + vz * t - cactus.z;
        if (dx * dx + dz * dz <= cactus.hitRadius * cactus.hitRadius) {
          racer.hitCacti.add(i);
          onHit();
        }
      }
    };

    hit(player, () => {
      if (player.slowTimer < 1) player.slowReason = '선인장 충돌';
      player.slowTimer = Math.max(player.slowTimer, 1);
      toast('선인장에 부딪혔어요! 1초 동안 속도가 느려집니다!');
    });

    if (freezeAI) return;
    ai.forEach((rider, index) => {
      if (rider.eliminated || rider.beingEaten || rider.beingPillarStruck) return;
      hit(rider, () => {
        rider.slowTimer = Math.max(rider.slowTimer, 1);
        toast(`${rider.name}이(가) 선인장에 부딪혔어요!`);
      });
    });
  }

  // 철구는 주인을 제외한 상대에게 맞으면 3초 동안 이동 속도를 45% 낮춥니다.
  // 한 번의 철구 사용으로 같은 상대를 계속 때려 무한히 느려지지 않도록 1회만 판정합니다.
  function applySteelBallCollisions() {
    // 다른 차원에 있는 플레이어는 현실의 AI와 철구를 주고받지 않습니다.
    // AI끼리의 철구 충돌은 현실에서 계속 처리합니다.
    const targets = [
      ...(!dimension.active ? [{ id: 'player', x: player.x, z: player.z, y: player.y, setSlow: () => { player.slowTimer = 3; player.slowReason = '철구 충격'; } }] : []),
      ...ai.map((rider, index) => ({ rider, index })).filter(v => !v.rider.eliminated && !v.rider.beingEaten && !v.rider.beingPillarStruck).map(({rider, index}) => ({
        id: `ai${index}`, x: rider.x, z: rider.z, y: rider.y,
        setSlow: () => { rider.slowTimer = 3; }
      }))
    ];

    const activeBalls = [];
    if (!dimension.active && steelBall && steelBall.state === 'orbit') {
      activeBalls.push({ ownerId: 'player', x: steelBall.lastX, z: steelBall.lastZ, y: steelBall.lastY, hitTargets: steelBall.hitTargets });
    }
    ai.forEach((rider, index) => {
      if (!rider.eliminated && !rider.beingEaten && !rider.beingPillarStruck && rider.ballTimer > 0) {
        activeBalls.push({
          ownerId: `ai${index}`,
          x: rider.x + Math.cos(rider.ballAngle) * 3.7,
          z: rider.z + Math.sin(rider.ballAngle) * 3.7,
          y: rider.y + 2.35 + Math.sin(rider.ballAngle * 1.8) * .45,
          hitTargets: rider.ballHitTargets
        });
      }
    });

    for (const ball of activeBalls) {
      for (const target of targets) {
        if (target.id === ball.ownerId || ball.hitTargets.has(target.id)) continue;
        const dx = ball.x - target.x;
        const dz = ball.z - target.z;
        const horizontalDistance = Math.hypot(dx, dz);
        const verticalDistance = Math.abs(ball.y - (target.y + 1.1));
        if (horizontalDistance < 2.6 && verticalDistance < 3.2) {
          ball.hitTargets.add(target.id);
          target.setSlow();
          if (target.id === 'player') toast('철구에 맞았어요! 3초 동안 속도가 느려집니다!');
          else toast(`${ai[Number(target.id.slice(2))].name}이(가) 철구에 맞았어요!`);
        }
      }
    }
  }

  function finishRace() {
    if (phase === 'finished') return;
    phase = 'finished';
    dimension.active = false; dimension.timeLeft = 0; $('dimensionBanner').style.display = 'none';
    timeStop.active = false; timeStop.timeLeft = 0; $('timeStopBanner').style.display = 'none';
    $('theWorldShout').classList.remove('show');
    $('dimensionShout').classList.remove('show'); dimensionShoutTimer = 0;
    $('loveTrainShout').classList.remove('show'); loveTrainShoutTimer = 0;
    if (loveTrainAttack && loveTrainAttack.target) loveTrainAttack.target.beingPillarStruck = false;
    loveTrainAttack = null;
    keys.clear();
    const place = 1 + ai.filter(r => !r.eliminated && r.z > player.z).length;
    $('resultTitle').textContent = '완주 성공!';
    $('resultText').innerHTML = `사막 코스를 끝까지 달렸어요!<br><b>최종 순위: ${place}위 / ${ai.length + 1}위</b><br>경주 시간: ${raceTime.toFixed(1)}초<br><span style="color:#f2d4a5;font-size:13px">완주가 성공 조건이에요. 멋진 경주였어요!</span>`;
    overlay.style.display = 'flex'; introCard.style.display = 'none'; resultCard.style.display = 'block';
    if (document.pointerLockElement) document.exitPointerLock?.();
  }

  function updateHud() {
    const remaining = Math.max(0, FINISH - player.z);
    $('distanceValue').textContent = Math.ceil(remaining).toLocaleString('ko-KR');
    $('progressFill').style.width = (Math.max(0, Math.min(1, player.z / FINISH)) * 100) + '%';
    $('staminaFill').style.width = (player.stamina / 30 * 100) + '%';
    $('staminaText').textContent = player.stamina > .1 ? `${Math.ceil(player.stamina)}초 남음` : '회복 중 · 15초';
    $('rankLabel').textContent = dimension.active ? '현실 기준 순위' : '현재 순위';
    $('rankValue').textContent = 1 + ai.filter(r => !r.eliminated && r.z > player.z).length;
    $('rankSuffix').textContent = ` / ${ai.length + 1}위`;
    $('speedValue').textContent = Math.round(player.speed * 3.6);
    $('slowStatus').style.display = player.slowTimer > 0 ? 'block' : 'none';
    $('slowStatus').textContent = player.slowTimer > 0 ? `${player.slowReason || '충돌'}! ${player.slowTimer.toFixed(1)}초 속도 감소` : '';
    $('viewValue').textContent = firstPerson ? '1인칭 시점' : '3인칭 시점';
    $('jumpState').textContent = cooldowns.jump > 0 ? `${cooldowns.jump.toFixed(1)}초` : '사용 가능';
    $('ropeState').textContent = cooldowns.rope > 0 ? `${cooldowns.rope.toFixed(1)}초` : '사용 가능';
    $('ballState').textContent = cooldowns.ball > 0 ? `${cooldowns.ball.toFixed(1)}초` : '사용 가능';
    $('dinoState').textContent = dimension.active ? '차원에서는 사용 불가' : (cooldowns.dino > 0 ? `${cooldowns.dino.toFixed(1)}초` : '사용 가능');
    $('dimensionState').textContent = dimension.active ? `${dimension.timeLeft.toFixed(1)}초 남음` : (cooldowns.dimension > 0 ? `${cooldowns.dimension.toFixed(1)}초` : '사용 가능');
    $('loveTrainState').textContent = loveTrainAttack ? (loveTrainAttack.phase === 'orbit' ? '기둥 회전 중' : loveTrainAttack.phase === 'rain' ? `${loveTrainAttack.strikeIndex + 1}/3 공격` : '공격 완료') : (cooldowns.loveTrain > 0 ? `${cooldowns.loveTrain.toFixed(1)}초` : '사용 가능');
    $('timeStopState').textContent = timeStop.active ? `${timeStop.timeLeft.toFixed(1)}초 정지` : (cooldowns.timeStop > 0 ? `${cooldowns.timeStop.toFixed(1)}초` : '사용 가능');
    $('sprintState').textContent = player.stamina > .1 ? `${Math.ceil(player.stamina)}초 남음` : '회복 중';
  }

  function currentCamera() {
    // 공룡 스킬이 실행되어도 카메라는 계속 플레이어를 기준으로 유지합니다.
    // 플레이어는 평소처럼 이동하고, 공룡만 코스 위에서 달립니다.
    return firstPerson
      ? { x: player.x, z: player.z, yaw: player.yaw, height: 2.55 + player.y, horizon: H*.36 }
      : { x: player.x - Math.sin(player.yaw)*15, z: player.z - Math.cos(player.yaw)*15, yaw: player.yaw, height: 5.3 + player.y*.45, horizon: H*.36 };
  }

  function project(x, z, y, camera) {
    const dx = x - camera.x;
    const dz = z - camera.z;
    const forwardZ = dx * Math.sin(camera.yaw) + dz * Math.cos(camera.yaw);
    const cameraX = dx * Math.cos(camera.yaw) - dz * Math.sin(camera.yaw);
    if (forwardZ < 1.5) return null;
    const focal = H * .93;
    const scale = focal / forwardZ;
    return { x: W * .5 + cameraX * scale, y: camera.horizon + (camera.height - y) * scale, scale, depth: forwardZ };
  }

  function polygon(points, fill, stroke, lineWidth) {
    if (points.some(p => !p)) return;
    ctx.beginPath(); ctx.moveTo(points[0].x, points[0].y);
    for (let i = 1; i < points.length; i++) ctx.lineTo(points[i].x, points[i].y);
    ctx.closePath();
    if (fill) { ctx.fillStyle = fill; ctx.fill(); }
    if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = lineWidth || 1; ctx.stroke(); }
  }

  function drawSky() {
    const sky = ctx.createLinearGradient(0, 0, 0, H * .68);
    if (dimension.active) {
      sky.addColorStop(0, '#10133d'); sky.addColorStop(.5, '#34306d'); sky.addColorStop(1, '#8060a0');
      ctx.fillStyle = sky; ctx.fillRect(0, 0, W, H);
      const moonX = W * .76, moonY = H * .17, moonR = Math.min(W, H) * .062;
      const glow = ctx.createRadialGradient(moonX, moonY, moonR * .1, moonX, moonY, moonR * 3.4);
      glow.addColorStop(0, 'rgba(177,230,255,.75)'); glow.addColorStop(1, 'rgba(114,104,255,0)');
      ctx.fillStyle = glow; ctx.beginPath(); ctx.arc(moonX, moonY, moonR * 3.4, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#d8f5ff'; ctx.beginPath(); ctx.arc(moonX, moonY, moonR, 0, Math.PI * 2); ctx.fill();
      for (let i = 0; i < 70; i++) {
        const sx = (i * 127.7 + 31) % W;
        const sy = (i * 53.9 + 17) % (H * .45);
        const radius = 1 + (i % 3) * .55;
        ctx.fillStyle = `rgba(210,235,255,${.35 + (i % 5) * .12})`;
        ctx.beginPath(); ctx.arc(sx, sy, radius, 0, Math.PI * 2); ctx.fill();
      }
    } else {
      sky.addColorStop(0, '#65a9c0'); sky.addColorStop(.58, '#f3c47c'); sky.addColorStop(1, '#f7d59b');
      ctx.fillStyle = sky; ctx.fillRect(0, 0, W, H);
      const sunX = W * .78, sunY = H * .19, sunR = Math.min(W, H) * .055;
      const glow = ctx.createRadialGradient(sunX, sunY, sunR * .15, sunX, sunY, sunR * 2.5);
      glow.addColorStop(0, 'rgba(255,244,190,.85)'); glow.addColorStop(1, 'rgba(255,226,157,0)');
      ctx.fillStyle = glow; ctx.beginPath(); ctx.arc(sunX, sunY, sunR * 2.5, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#fff0bc'; ctx.beginPath(); ctx.arc(sunX, sunY, sunR, 0, Math.PI * 2); ctx.fill();
    }
    // 멀리 겹쳐진 사막 언덕 / 차원에서는 보랏빛 수정 언덕
    for (let layer = 0; layer < 3; layer++) {
      const base = H * (.36 + layer * .055);
      ctx.beginPath(); ctx.moveTo(0, H);
      for (let x = 0; x <= W + 20; x += 20) {
        const y = base + Math.sin(x * (.004 + layer * .001) + layer * 2.1) * (18 + layer * 12) + Math.sin(x * .011 + layer) * 7;
        ctx.lineTo(x, y);
      }
      ctx.lineTo(W, H); ctx.closePath();
      const normalColors = ['#dba768','#c98e50','#b8783e'];
      const dimensionColors = ['#8b79bb','#63569a','#40366f'];
      ctx.fillStyle = (dimension.active ? dimensionColors : normalColors)[layer]; ctx.fill();
    }
  }

  function drawRoad(camera) {
    const startOffset = firstPerson ? 4 : -23;
    const roadOriginZ = player.z;
    for (let d = 350; d > startOffset; d -= 6) {
      const zFar = roadOriginZ + d;
      const zNear = zFar - 6;
      const cFar = trackCenter(zFar), cNear = trackCenter(zNear);
      const leftFar = project(cFar - ROAD_HALF, zFar, 0, camera);
      const rightFar = project(cFar + ROAD_HALF, zFar, 0, camera);
      const leftNear = project(cNear - ROAD_HALF, zNear, 0, camera);
      const rightNear = project(cNear + ROAD_HALF, zNear, 0, camera);
      if (!leftFar || !rightFar || !leftNear || !rightNear) continue;
      // 밝은 모래 어깨와 다져진 경주로
      const shoulder = 1.5;
      polygon([
        project(cFar - ROAD_HALF - shoulder, zFar, 0, camera),
        project(cFar + ROAD_HALF + shoulder, zFar, 0, camera),
        project(cNear + ROAD_HALF + shoulder, zNear, 0, camera),
        project(cNear - ROAD_HALF - shoulder, zNear, 0, camera)
      ], dimension.active ? '#584b8d' : '#e9bd7d');
      polygon([leftFar, rightFar, rightNear, leftNear], dimension.active
        ? (Math.floor(d / 6) % 2 ? '#3b326b' : '#51427f')
        : (Math.floor(d / 6) % 2 ? '#b8773d' : '#c18147'));
      // 도로 중앙의 짧은 노란 점선
      if (Math.floor(d / 6) % 3 !== 1) {
        const mFar = project(cFar, zFar, .025, camera), mNear = project(cNear, zNear, .025, camera);
        if (mFar && mNear) {
          ctx.strokeStyle = dimension.active ? 'rgba(142,231,255,.92)' : 'rgba(255,224,145,.78)'; ctx.lineWidth = Math.max(1, mNear.scale * .19);
