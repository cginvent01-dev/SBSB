<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>스틸볼런 - 사막 경주</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #d9a45f; font-family: system-ui, -apple-system, "Malgun Gothic", sans-serif; }
  canvas { display: block; width: 100%; height: 100%; cursor: crosshair; }
  #hud { position: fixed; inset: 0; pointer-events: none; color: #fff8e9; text-shadow: 0 2px 5px #4b2c17; display: none; }
  .panel { background: rgba(42, 28, 18, .66); border: 1px solid rgba(255,240,210,.25); border-radius: 13px; padding: 11px 14px; box-shadow: 0 5px 18px rgba(39,22,8,.22); backdrop-filter: blur(4px); }
  #topLeft { position: absolute; top: 14px; left: 14px; width: min(290px, calc(50vw - 22px)); }
  #topRight { position: absolute; top: 14px; right: 14px; min-width: 155px; text-align: right; }
  .smallLabel { font-size: 11px; opacity: .8; letter-spacing: .04em; }
  .bigNumber { font-weight: 900; font-size: 24px; line-height: 1.25; }
  .bar { height: 9px; margin-top: 6px; overflow: hidden; background: rgba(255,255,255,.18); border-radius: 20px; }
  .bar > div { height: 100%; width: 100%; border-radius: inherit; background: linear-gradient(90deg,#a8e56f,#e9e56c); transition: width .08s linear; }
  #progressFill { background: linear-gradient(90deg,#ffdc75,#fff3b4); }
  #skillPanel { position: absolute; bottom: 15px; left: 15px; display: flex; gap: 8px; flex-wrap: wrap; max-width: min(780px, calc(100vw - 30px)); }
  .skill { min-width: 94px; padding: 8px 10px; text-align: center; }
  .skillKey { font-weight: 900; font-size: 18px; }
  .skillName { font-size: 11px; white-space: nowrap; }
  .skillState { font-size: 10px; opacity: .85; min-height: 14px; }
  #bottomRight { position: absolute; right: 14px; bottom: 15px; text-align: right; font-size: 12px; line-height: 1.55; }
  #raceMessage { position: absolute; top: 24%; left: 50%; transform: translateX(-50%); font-size: clamp(32px, 6vw, 66px); font-weight: 1000; color: #fff4c8; text-shadow: 0 4px 0 #7b3d1d, 0 7px 18px #472713; white-space: nowrap; }
  #dimensionBanner { position: absolute; top: 76px; left: 50%; transform: translateX(-50%); padding: 10px 18px; border-radius: 16px; text-align: center; background: rgba(28,18,74,.72); border: 1px solid rgba(155,221,255,.55); box-shadow: 0 0 24px rgba(96,156,255,.25); color: #e9f4ff; display: none; min-width: 210px; }
  #dimensionBanner strong { display: block; font-size: 15px; letter-spacing: .12em; }
  #dimensionBanner span { font-size: 12px; color: #bce8ff; }
  #dimensionShout {
    position: absolute; left: 50%; top: 39%; z-index: 20;
    display: none; transform: translate(-50%, -50%);
    font-size: clamp(64px, 12vw, 132px); line-height: 1;
    font-weight: 1000; letter-spacing: .04em; white-space: nowrap;
    color: #ffc1df; -webkit-text-stroke: 2px rgba(255,245,251,.9);
    text-shadow: 0 0 10px #ff8fc8, 0 0 28px #ff62b5, 0 8px 0 #a83d78, 0 14px 28px rgba(75,12,55,.65);
    pointer-events: none;
  }
  #dimensionShout.show { display: block; animation: d4cFlash 1.9s cubic-bezier(.18,.78,.22,1) both; }
  @keyframes d4cFlash {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(.35) rotate(-9deg); filter: blur(8px); }
    16% { opacity: 1; transform: translate(-50%, -50%) scale(1.18) rotate(3deg); filter: blur(0); }
    30% { transform: translate(-50%, -50%) scale(1) rotate(0); }
    72% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.35) rotate(5deg); filter: blur(3px); }
  }
  #theWorldShout {
    position: absolute; left: 50%; top: 39%; z-index: 24;
    display: none; transform: translate(-50%, -50%);
    font-size: clamp(58px, 11vw, 124px); line-height: 1;
    font-weight: 1000; letter-spacing: .04em; white-space: nowrap;
    color: #fff36a; -webkit-text-stroke: 2px rgba(255,255,220,.95);
    text-shadow: 0 0 12px #fff36a, 0 0 30px #ffcf27, 0 9px 0 #986600, 0 15px 30px rgba(35,22,0,.78);
    pointer-events: none;
  }
  #theWorldShout.show { display: block; animation: theWorldFlash 1.8s cubic-bezier(.18,.78,.22,1) both; }
  @keyframes theWorldFlash {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(.25) rotate(-12deg); filter: blur(10px); }
    18% { opacity: 1; transform: translate(-50%, -50%) scale(1.2) rotate(3deg); filter: blur(0); }
    34%, 76% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.35) rotate(5deg); filter: blur(4px); }
  }
  #timeStopBanner {
    position: absolute; top: 76px; left: 50%; transform: translateX(-50%);
    display: none; min-width: 210px; padding: 10px 18px; border-radius: 16px;
    text-align: center; color: #fff7b0; background: rgba(49,35,0,.82);
    border: 1px solid rgba(255,229,91,.85); box-shadow: 0 0 26px rgba(255,213,39,.32);
  }
  #timeStopBanner strong { display: block; font-size: 16px; letter-spacing: .12em; }
  #timeStopBanner span { font-size: 12px; color: #fff0a0; }
  #loveTrainShout {
    position: absolute; left: 50%; top: 27%; z-index: 21;
    display: none; transform: translate(-50%, -50%);
    font-size: clamp(34px, 7vw, 78px); line-height: 1.1;
    font-weight: 1000; letter-spacing: .015em; white-space: nowrap;
    color: #ffe84a; -webkit-text-stroke: 1.7px #fff8b0;
    text-shadow: 0 0 9px #fff36a, 0 0 23px #ffcf21, 0 7px 0 #9b6500, 0 12px 24px rgba(60,35,0,.72);
    pointer-events: none;
  }
  #loveTrainShout.show { display: block; animation: loveTrainFlash 2.1s cubic-bezier(.18,.78,.22,1) both; }
  @keyframes loveTrainFlash {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(.35) rotate(-7deg); filter: blur(7px); }
    15% { opacity: 1; transform: translate(-50%, -50%) scale(1.12) rotate(2deg); filter: blur(0); }
    30%, 76% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.25) rotate(4deg); filter: blur(4px); }
  }
  #toast { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); padding: 9px 15px; border-radius: 30px; background: rgba(50,31,17,.75); font-size: 13px; opacity: 0; transition: opacity .2s; }
  #overlay { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; padding: 18px; background: linear-gradient(rgba(39,24,13,.26),rgba(39,24,13,.62)); color: #fff5df; }
  .card { width: min(720px, 100%); max-height: min(92vh, 850px); overflow: auto; padding: clamp(20px, 4vw, 36px); border-radius: 24px; background: rgba(53, 34, 20, .93); border: 1px solid rgba(255,234,191,.36); box-shadow: 0 20px 70px rgba(25,13,5,.45); }
  h1 { margin: 0 0 7px; font-size: clamp(34px, 7vw, 62px); line-height: 1; letter-spacing: -.05em; color: #ffe18d; text-shadow: 0 4px 0 #8b4a24; }
  .subtitle { margin: 10px 0 20px; color: #f4d5a1; font-size: 15px; }
  .instructions { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 9px; margin: 18px 0 22px; }
  .instruction { padding: 10px 12px; border-radius: 12px; background: rgba(255,238,206,.09); border: 1px solid rgba(255,238,206,.12); font-size: 13px; line-height: 1.5; }
  .instruction b { color: #ffe18d; }
  .notice { font-size: 12px; line-height: 1.6; color: #eacba0; }
  button { border: 0; border-radius: 14px; padding: 13px 25px; font-size: 16px; font-weight: 900; color: #4a2a13; background: linear-gradient(180deg,#ffe79a,#eebd59); box-shadow: 0 5px 0 #9a5a28, 0 8px 18px rgba(0,0,0,.2); cursor: pointer; }
  button:hover { filter: brightness(1.08); transform: translateY(-1px); }
  button:active { transform: translateY(2px); box-shadow: 0 2px 0 #9a5a28; }
  #startBtn, #againBtn { width: 100%; margin-top: 5px; }
  #resultCard { display: none; text-align: center; }
  #resultTitle { font-size: clamp(30px, 6vw, 48px); color: #ffe18d; margin: 5px 0 10px; }
  #resultText { line-height: 1.8; margin-bottom: 20px; }
  @media (max-width: 560px) {
    #topLeft { top: 8px; left: 8px; padding: 8px 10px; width: 190px; }
    #topRight { top: 8px; right: 8px; padding: 8px 10px; min-width: 112px; }
    .bigNumber { font-size: 19px; }
    #skillPanel { left: 8px; bottom: 8px; gap: 5px; }
    .skill { min-width: 73px; padding: 6px 7px; }
    #bottomRight { right: 8px; bottom: 8px; font-size: 10px; }
    .instructions { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<canvas id="game" aria-label="스틸볼런 사막 경주 게임 화면"></canvas>

<div id="hud">
  <div id="topLeft" class="panel">
    <div class="smallLabel">완주까지 남은 거리</div>
    <div class="bigNumber"><span id="distanceValue">0</span><span style="font-size:13px;font-weight:600"> m</span></div>
    <div class="bar"><div id="progressFill"></div></div>
    <div style="display:flex;justify-content:space-between;margin-top:9px;gap:8px">
      <div style="flex:1"><div class="smallLabel">질주 스태미나</div><div class="bar"><div id="staminaFill"></div></div><div id="staminaText" style="font-size:11px;margin-top:3px">30초</div></div>
    </div>
  </div>
  <div id="topRight" class="panel">
    <div class="smallLabel" id="rankLabel">현재 순위</div>
    <div class="bigNumber"><span id="rankValue">1</span><span id="rankSuffix" style="font-size:13px"> / 31위</span></div>
    <div class="smallLabel" style="margin-top:8px">말 속도</div>
    <div style="font-weight:900;font-size:20px"><span id="speedValue">0</span><span style="font-size:11px"> km/h</span></div>
    <div id="slowStatus" class="smallLabel" style="margin-top:5px;color:#ffb0a2;display:none;font-weight:800">충돌! 속도 감소</div>
    <div id="viewValue" class="smallLabel" style="margin-top:6px">1인칭 시점</div>
  </div>
  <div id="skillPanel">
    <div class="panel skill"><div class="skillKey">SHIFT</div><div class="skillName">빠르게 달리기</div><div class="skillState" id="sprintState">최대 30초</div></div>
    <div class="panel skill"><div class="skillKey">C</div><div class="skillName">초강력 점프</div><div class="skillState" id="jumpState">사용 가능</div></div>
    <div class="panel skill"><div class="skillKey">F</div><div class="skillName">밧줄 이동</div><div class="skillState" id="ropeState">사용 가능</div></div>
    <div class="panel skill"><div class="skillKey">G</div><div class="skillName">철구 회전</div><div class="skillState" id="ballState">5초 회전</div></div>
    <div class="panel skill"><div class="skillKey">T</div><div class="skillName">공룡 소환</div><div class="skillState" id="dinoState">30초 대기시간</div></div>
    <div class="panel skill"><div class="skillKey">X</div><div class="skillName">다른 차원</div><div class="skillState" id="dimensionState">5초 다른 차원</div></div>
    <div class="panel skill"><div class="skillKey">B</div><div class="skillName">러브 트레인</div><div class="skillState" id="loveTrainState">사용 가능</div></div>
    <div class="panel skill"><div class="skillKey">좌클릭</div><div class="skillName">더 월드</div><div class="skillState" id="timeStopState">5초 정지</div></div>
  </div>
  <div id="dimensionBanner"><strong>✧ 다른 차원 ✧</strong><span id="dimensionTimer">5.0초 남음 · AI도 계속 달려요</span></div>
  <div id="dimensionShout" aria-hidden="true">D4C!</div>
  <div id="loveTrainShout" aria-hidden="true">D4C! 러브트레인!</div>
  <div id="theWorldShout" aria-hidden="true">더월드!</div>
  <div id="timeStopBanner"><strong>THE WORLD</strong><span id="timeStopTimer">5.0초 · 시간 정지</span></div>
  <div id="bottomRight" class="panel">
    <b>W A S D</b> 이동　 <b>V</b> 시점 변경<br>
    <b>CTRL</b> 시점 고정 켜기/끄기　 <b>ESC</b> 해제
  </div>
  <div id="raceMessage"></div>
  <div id="toast"></div>
</div>

<div id="overlay">
  <div class="card" id="introCard">
    <h1>스틸볼런</h1>
    <div class="subtitle">뜨거운 사막을 달려 결승선까지! AI 기수 30명과 함께 말 경주를 시작하세요.</div>
    <div class="instructions">
      <div class="instruction"><b>W / A / S / D</b><br>말을 앞·왼쪽·뒤·오른쪽으로 이동해요.</div>
      <div class="instruction"><b>CTRL 한 번 누르기</b><br>한 번 누르면 마우스 시점 조작이 켜지고, 다시 누르면 꺼져요. 마우스를 움직여 방향을 바꿔요. W는 바라보는 방향으로 이동해요.</div>
      <div class="instruction"><b>SHIFT · 질주</b><br>최대 30초 동안 빨리 달려요. 스태미나는 비어 있을 때 15초 동안 회복돼요.</div>
      <div class="instruction"><b>C · 초강력 점프</b><br>높이 점프해요. 다시 사용하려면 10초가 필요해요.</div>
      <div class="instruction"><b>F · 밧줄 이동</b><br>바라보는 방향으로 밧줄을 던져 앞으로 끌려가요. 재사용 대기시간은 10초예요.</div>
      <div class="instruction"><b>G · 철구 회전</b><br>철구가 주위를 5초 동안 돌아요. 상대가 맞으면 3초 동안 속도가 45% 느려져요. 재사용 대기시간은 10초예요.</div>
      <div class="instruction"><b>T · 파란 공룡 소환</b><br>플레이어 시점은 그대로예요. 눈앞의 코스 바닥에서 커다란 파란 공룡이 튀어나와 “Dio!”를 외치며 앞서 달리는 AI 한 명을 쫓아가 잡아먹어요. 재사용 대기시간은 30초이며 플레이어만 사용할 수 있어요.</div>
      <div class="instruction"><b>X · 다른 차원</b><br>5초 동안 나 혼자 다른 차원으로 이동해요. AI는 현실에 남아 화면에서 보이지 않지만, 그동안에도 현실 코스에서 계속 달려요. 현실로 돌아오면 AI가 달린 거리도 반영돼요. 차원 안에서는 이동 속도가 40% 빨라져요. C·F·G 스킬 쿨타임은 15초이며, X의 쿨타임은 차원에 있는 5초 동안 멈춰 있고 현실로 돌아온 뒤부터 15초가 흘러야 다시 사용할 수 있어요.</div>
      <div class="instruction"><b>B · D4C! 러브트레인!</b><br>플레이어 주변을 여러 개의 노란 기둥이 빙글빙글 돌아요. 기둥들이 AI 한 명을 향해 이동한 뒤, AI의 진행 경로에 일렬로 세 번 떨어져요. 세 번째 기둥까지 맞으면 그 AI는 경주에서 탈락해요. 재사용 대기시간은 30초예요.</div>
      <div class="instruction"><b>마우스 좌클릭 · 더월드!</b><br>5초 동안 시간이 멈춰요. AI와 AI의 스킬, 공룡과 황금 기둥은 정지하고 나만 말을 움직일 수 있어요. 재사용 대기시간은 15초예요.</div>
      <div class="instruction"><b>V · 시점 변경</b><br>1인칭과 3인칭을 번갈아 바꿔요. 시작 시점은 1인칭이에요.</div>
      <div class="instruction"><b>선인장 장애물</b><br>경주로 위에 있는 선인장을 피하세요! 닿으면 플레이어와 AI 모두 1초 동안 속도가 느려져요. 선인장의 충돌 판정은 작게 만들었어요.</div>
      <div class="instruction"><b>경주 규칙</b><br>사막의 정해진 길 안에서 달려야 해요. AI 기수 30명도 질주·점프·밧줄·철구 스킬을 사용해요. 완주하면 성공!</div>
    </div>
    <div class="notice">조작 팁: 경주 중 CTRL을 한 번 누르면 마우스 시점 조작이 켜지고, 다시 누르면 꺼져요. 브라우저가 마우스 잠금을 허용하지 않아도 마우스를 움직여 방향을 바꿀 수 있어요. ESC를 누르면 잠금을 풀 수 있어요.</div>
    <button id="startBtn">경주 시작!</button>
  </div>
  <div class="card" id="resultCard">
    <div style="font-size:48px">🏁 🐎</div>
    <div id="resultTitle">완주 성공!</div>
    <div id="resultText"></div>
    <button id="againBtn">다시 경주하기</button>
  </div>
</div>

<script>
(() => {
  'use strict';
  const canvas = document.getElementById('game');
  const ctx = canvas.getContext('2d');
  const $ = (id) => document.getElementById(id);
  const HUD = $('hud');
  const overlay = $('overlay');
  const introCard = $('introCard');
  const resultCard = $('resultCard');

  const FINISH = 1800;
  const ROAD_HALF = 22.5;
  const GRAVITY = 34;
  let W = innerWidth, H = innerHeight, DPR = 1;
  let phase = 'menu'; // menu, countdown, racing, finished
  let countdown = 3;
  let lastTime = 0;
  let messageTimer = 0;
  let dragLook = false;
  let lastMouseX = 0;
  let pointerLocked = false;
  let mouseLookEnabled = false;
  let showMessageTimer = 0;
  let dimensionShoutTimer = 0;
  const keys = new Set();
  const cooldowns = { jump: 0, rope: 0, ball: 0, dino: 0, dimension: 0, loveTrain: 0, timeStop: 0 };
  const timeStop = { active: false, timeLeft: 0, duration: 5 };
  let timeStopShoutTimer = 0;
  let dinoAttack = null;
  let loveTrainAttack = null;
  let loveTrainShoutTimer = 0;
  const dimension = { active: false, timeLeft: 0, elapsed: 0, entryZ: 0 };

  const player = { x: 0, z: 0, yaw: 0, y: 0, vy: 0, stamina: 30, staminaRecovering: false, speed: 0, gaitTime: 0, slowTimer: 0, slowReason: '', hitCacti: new Set() };
  let firstPerson = true;
  let rope = null;
  let steelBall = null;
  let raceTime = 0;
  let ai = [];
  let decor = [];
  let cactusObstacles = [];
  let lastToast = '';

  function resize() {
    W = innerWidth; H = innerHeight;
    DPR = Math.min(devicePixelRatio || 1, 1.7);
    canvas.width = Math.round(W * DPR);
    canvas.height = Math.round(H * DPR);
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }
  addEventListener('resize', resize);
  resize();

  function trackCenter(z) {
    return 23 * Math.sin(z / 225) + 10 * Math.sin(z / 83) + 4 * Math.sin(z / 39);
  }
  function clampToTrack() {
    const middle = trackCenter(player.z);
    const old = player.x;
    player.x = Math.max(middle - ROAD_HALF + 1, Math.min(middle + ROAD_HALF - 1, player.x));
    if (Math.abs(old - player.x) > 0.001) toast('정해진 코스 안에서 달려야 해요!');
    player.z = Math.max(0, Math.min(FINISH, player.z));
  }
  function random01(seed) {
    const v = Math.sin(seed * 127.1 + 311.7) * 43758.5453;
    return v - Math.floor(v);
  }
  function makeDecor() {
    decor = [];
    cactusObstacles = [];
    // 경주로 안쪽에 선인장 장애물을 배치해 피해서 달릴 수 있게 합니다.
    const obstacleLanes = [-13.0, -6.5, 0, 6.5, 13.0];
    for (let i = 0; i < 23; i++) {
      const z = 95 + i * 74;
      const laneIndex = Math.floor(random01(i * 31 + 9) * obstacleLanes.length);
      cactusObstacles.push({
        x: trackCenter(z) + obstacleLanes[laneIndex],
        z,
        size: 0.82 + random01(i * 17 + 4) * 0.16,
        hitRadius: 0.95
