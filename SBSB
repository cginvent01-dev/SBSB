  function drawYellowPillar(x, z, camera, baseY = 0, height = 9, sizeFactor = 1, glow = 18) {
    const bottom = project(x, z, baseY, camera);
    const top = project(x, z, baseY + height, camera);
    if (!bottom || !top || bottom.depth > 350 || bottom.x < -160 || bottom.x > W + 160) return;
    const width = Math.max(3, Math.min(58, bottom.scale * 1.35 * sizeFactor));
    const half = width * .5;
    ctx.save();
    ctx.shadowColor = '#ffe94d'; ctx.shadowBlur = glow;
    // 중앙의 밝은 금빛 면과 양옆의 어두운 면으로 기둥의 입체감을 표현합니다.
    polygon([
      { x: top.x - half * .68, y: top.y },
      { x: top.x + half * .45, y: top.y - half * .22 },
      { x: bottom.x + half * .45, y: bottom.y - half * .22 },
      { x: bottom.x - half * .68, y: bottom.y }
    ], '#ffe65a', '#fff7ad', Math.max(1, width * .07));
    polygon([
      { x: top.x + half * .45, y: top.y - half * .22 },
      { x: top.x + half, y: top.y + half * .04 },
      { x: bottom.x + half, y: bottom.y + half * .04 },
      { x: bottom.x + half * .45, y: bottom.y - half * .22 }
    ], '#d99408', '#fff0a0', Math.max(1, width * .045));
    ctx.shadowBlur = glow * .55;
    ctx.strokeStyle = 'rgba(255,255,210,.95)'; ctx.lineWidth = Math.max(1, width * .09);
    ctx.beginPath(); ctx.moveTo(top.x - half * .12, top.y + 2); ctx.lineTo(bottom.x - half * .12, bottom.y - 2); ctx.stroke();
    // 바닥에 빛나는 원형 충격 범위
    ctx.shadowBlur = 0;
    ctx.strokeStyle = 'rgba(255,226,57,.9)'; ctx.lineWidth = Math.max(1.5, width * .09);
    ctx.beginPath(); ctx.ellipse(bottom.x, bottom.y, width * 1.12, Math.max(2, width * .26), 0, 0, Math.PI * 2); ctx.stroke();
    ctx.restore();
  }

  function drawLoveTrainEffects(camera) {
    const attack = loveTrainAttack;
    if (!attack) return;

    // 첫 단계: 플레이어 주변에서 여러 황금 기둥이 빙글빙글 공전합니다.
    if (attack.phase === 'orbit') {
      const count = 7;
      for (let i = 0; i < count; i++) {
        const angle = attack.angle + i * Math.PI * 2 / count;
        const radius = 5.2 + Math.sin(attack.elapsed * 4 + i) * .55;
        const x = player.x + Math.cos(angle) * radius;
        const z = player.z + Math.sin(angle) * radius;
        const lift = 1.0 + (Math.sin(attack.elapsed * 7 + i * 1.3) + 1) * .65;
        drawYellowPillar(x, z, camera, lift, 5.5 + (i % 3) * .8, .88, 15);
      }
    }

    // 이미 떨어진 기둥은 잠깐 빛나는 충격파로 남습니다.
    for (const impact of attack.impacts) {
      const p = project(impact.x, impact.z, .06, camera);
      if (!p || p.depth > 350) continue;
      const fade = Math.max(0, impact.timer / impact.maxTimer);
      const radius = (1 - fade) * 34 + 7;
      ctx.save();
      ctx.globalAlpha = fade;
      ctx.shadowColor = '#ffe632'; ctx.shadowBlur = 24;
      ctx.strokeStyle = '#fff06a'; ctx.lineWidth = 4 * fade + 1;
      ctx.beginPath(); ctx.ellipse(p.x, p.y, radius, radius * .27, 0, 0, Math.PI * 2); ctx.stroke();
      ctx.fillStyle = 'rgba(255,225,35,.2)'; ctx.beginPath(); ctx.ellipse(p.x, p.y, radius * .75, radius * .18, 0, 0, Math.PI * 2); ctx.fill();
      ctx.restore();
    }

    // 두 번째 단계: 목표 AI의 주행 라인을 따라 세 개의 기둥이 차례로 떨어집니다.
    if (attack.phase === 'rain') {
      const offset = [-4.2, 0, 4.2][attack.strikeIndex] || 0;
      const strikeZ = Math.max(0, Math.min(FINISH, attack.baseZ + offset));
      const strikeX = trackCenter(strikeZ) + attack.laneOffset;
      const progress = Math.max(0, Math.min(1, attack.strikeElapsed / .42));
      const fallY = 23 * (1 - progress);
      drawYellowPillar(strikeX, strikeZ, camera, fallY, 8.5, 1.5, 28);
      const target = attack.target;
      if (target && !target.eliminated) {
        const targetPoint = project(target.x, target.z, target.y || 0, camera);
        if (targetPoint && target.pillarHitFlash > 0) {
          ctx.save();
          ctx.globalAlpha = Math.min(1, target.pillarHitFlash / .58);
          ctx.strokeStyle = '#fff07a'; ctx.lineWidth = 5; ctx.shadowColor = '#ffd900'; ctx.shadowBlur = 24;
          ctx.beginPath(); ctx.ellipse(targetPoint.x, targetPoint.y - targetPoint.scale * .55, targetPoint.scale * 1.7, targetPoint.scale * .7, 0, 0, Math.PI * 2); ctx.stroke();
          ctx.restore();
        }
      }
    }
  }

  function drawDinosaur(point, attack, camera) {
    if (!point) return;
    const ahead = project(trackCenter(attack.z + 7), attack.z + 7, 0, camera);
    let angle = ahead ? Math.atan2(ahead.y - point.y, ahead.x - point.x) : -Math.PI / 2;
    // 코스의 진행 방향을 바라보되, 먹는 순간에는 목표 쪽으로 살짝 고개를 돌립니다.
    if (attack.phase === 'eat') angle += .08 * Math.sin(attack.elapsed * 18);
    const u = Math.max(3.2, Math.min(42, point.scale * 1.22));
    const run = attack.phase === 'run' || attack.phase === 'emerge';
    const legSwing = run ? Math.sin(attack.gait) * .42 : Math.sin(attack.elapsed * 12) * .12;
    const jawOpen = attack.phase === 'eat' ? .42 + .26 * (0.5 + 0.5 * Math.sin(attack.elapsed * 20)) : .12;

    ctx.save();
    ctx.translate(point.x, point.y);
    ctx.rotate(angle);
    const emergeScale = attack.phase === 'emerge' ? 0.42 + 0.58 * Math.min(1, attack.elapsed / 0.48) : 1;
    ctx.scale(u * emergeScale, u * emergeScale);

    // 발밑 그림자와 길 위 모래먼지
    ctx.fillStyle = 'rgba(50,31,15,.28)';
    ctx.beginPath(); ctx.ellipse(-.1, -.04, 2.75, .48, 0, 0, Math.PI * 2); ctx.fill();
    if (run) {
      for (let i = 0; i < 3; i++) {
        ctx.fillStyle = `rgba(240,198,133,${.24 - i * .055})`;
        ctx.beginPath(); ctx.arc(-2.5 - i * .58, -.18 - (i % 2) * .18, .22 + i * .08, 0, Math.PI * 2); ctx.fill();
      }
    }

    // 꼬리
    ctx.fillStyle = '#1264c6'; ctx.strokeStyle = '#083f91'; ctx.lineWidth = .13;
    ctx.beginPath(); ctx.moveTo(-1.45, -1.42); ctx.quadraticCurveTo(-2.5, -1.85, -3.55, -1.18); ctx.quadraticCurveTo(-2.95, -1.12, -2.25, -.82); ctx.lineTo(-1.25, -1.0); ctx.closePath(); ctx.fill(); ctx.stroke();

    // 네 다리: 실제 코스 진행에 맞춰 달리는 동작
    const legs = [
      { x: -.95, phase: legSwing }, { x: -.45, phase: legSwing + Math.PI },
      { x: .95, phase: legSwing + Math.PI }, { x: 1.35, phase: legSwing }
    ];
    for (const leg of legs) {
      const swing = Math.sin(leg.phase) * .43;
      const lift = Math.max(0, Math.cos(leg.phase)) * .24;
      ctx.strokeStyle = '#0b4fa9'; ctx.lineWidth = .38; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(leg.x, -1.0); ctx.lineTo(leg.x + swing * .5, -.48 - lift); ctx.lineTo(leg.x + swing, -.08 - lift); ctx.stroke();
      ctx.fillStyle = '#073c80'; ctx.beginPath(); ctx.ellipse(leg.x + swing, -.06 - lift, .34, .13, -.06, 0, Math.PI * 2); ctx.fill();
    }

    // 몸통과 밝은 배
    const blue = ctx.createLinearGradient(-1, -2.6, 1.8, -.45);
    blue.addColorStop(0, '#75d9ff'); blue.addColorStop(.48, '#2589ef'); blue.addColorStop(1, '#0750b1');
    ctx.fillStyle = blue; ctx.strokeStyle = '#073e8a'; ctx.lineWidth = .16;
    ctx.beginPath(); ctx.ellipse(-.05, -1.52, 1.72, .91, -.08, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#b9efff';
    ctx.beginPath(); ctx.ellipse(.18, -1.07, 1.25, .42, -.04, 0, Math.PI * 2); ctx.fill();

    // 목과 큰 머리
    ctx.fillStyle = '#1677df'; ctx.strokeStyle = '#073e8a'; ctx.lineWidth = .16;
    ctx.beginPath(); ctx.moveTo(.55, -1.9); ctx.lineTo(1.05, -2.72); ctx.quadraticCurveTo(1.48, -3.14, 2.15, -2.86); ctx.lineTo(2.55, -2.35); ctx.lineTo(1.95, -1.72); ctx.lineTo(1.18, -1.25); ctx.closePath(); ctx.fill(); ctx.stroke();
    ctx.beginPath(); ctx.ellipse(2.05, -2.63, .88, .57, -.08, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

    // 등쪽의 작은 공룡 돌기
    for (let i = 0; i < 5; i++) {
      const sx = -1.15 + i * .55;
      const sy = -2.16 - Math.sin(i / 4 * Math.PI) * .18;
      ctx.fillStyle = '#62caff'; ctx.beginPath(); ctx.moveTo(sx - .2, sy + .18); ctx.lineTo(sx, sy - .35); ctx.lineTo(sx + .22, sy + .18); ctx.closePath(); ctx.fill();
    }

    // 짧은 앞발
    ctx.strokeStyle = '#0a4eaa'; ctx.lineWidth = .25; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(.75, -1.48); ctx.lineTo(1.05, -1.08); ctx.lineTo(1.38, -1.2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(1.1, -1.53); ctx.lineTo(1.35, -1.18); ctx.lineTo(1.62, -1.3); ctx.stroke();

    // 위턱과 크게 벌어지는 아래턱
    ctx.fillStyle = '#0750a7'; ctx.strokeStyle = '#062f6d'; ctx.lineWidth = .11;
    ctx.beginPath(); ctx.moveTo(2.25, -2.49); ctx.quadraticCurveTo(3.1, -2.48, 3.38, -2.2); ctx.quadraticCurveTo(3.05, -2.03, 2.38, -2.12); ctx.closePath(); ctx.fill(); ctx.stroke();
    ctx.save();
    ctx.translate(2.35, -2.26);
    ctx.rotate(jawOpen);
    ctx.fillStyle = '#1677df';
    ctx.beginPath(); ctx.moveTo(0, 0); ctx.quadraticCurveTo(.7, .02, 1.1, .34); ctx.quadraticCurveTo(.65, .58, .1, .34); ctx.closePath(); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#fff';
    for (let i = 0; i < 4; i++) {
      const tx = .18 + i * .2;
      ctx.beginPath(); ctx.moveTo(tx, .03); ctx.lineTo(tx + .07, .23); ctx.lineTo(tx + .14, .04); ctx.closePath(); ctx.fill();
    }
    ctx.restore();
    ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(2.16, -2.89, .22, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#09264e'; ctx.beginPath(); ctx.arc(2.23, -2.88, .105, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(2.26, -2.94, .04, 0, Math.PI * 2); ctx.fill();

    // 공룡이 달려오는 동안 2초간 머리 위에 Dio! 문구가 함께 이동합니다.
    const labelX = point.x + Math.cos(angle) * 2.2 * u + Math.sin(angle) * 3.7 * u;
    const labelY = point.y + Math.sin(angle) * 2.2 * u - Math.cos(angle) * 3.7 * u;
    ctx.restore();
    if (attack.elapsed < 2.0) {
      ctx.save();
      const fontSize = Math.max(17, Math.min(46, u * 1.05));
      ctx.font = `1000 ${fontSize}px system-ui, sans-serif`;
      ctx.textAlign = 'center'; ctx.lineJoin = 'round';
      ctx.lineWidth = Math.max(3, fontSize * .12); ctx.strokeStyle = '#07316e';
      ctx.strokeText('Dio!', labelX, labelY);
      ctx.fillStyle = '#fff'; ctx.shadowColor = '#39a9ff'; ctx.shadowBlur = 16;
      ctx.fillText('Dio!', labelX, labelY);
      ctx.restore();
    }
  }

  function draw() {
    ctx.clearRect(0,0,W,H);
    drawSky();
    const camera = currentCamera();
    drawRoad(camera);
    drawDecorations(camera);

    // X 차원에 있는 동안에는 플레이어만 다른 차원에 있어요.
    // AI와 공룡은 현실 코스에서 계속 움직이지만, 플레이어의 차원 화면에는 나타나지 않습니다.
    if (!dimension.active) {
      // AI 기수는 먼 순서부터 그려요.
      const riders = ai.filter(r => !r.eliminated).map(r => ({ r, p: project(r.x, r.z, r.y || 0, camera) })).filter(v => v.p).sort((a,b)=>b.p.depth-a.p.depth);
      riders.forEach(v => {
        if (v.r.beingEaten && dinoAttack && dinoAttack.phase === 'eat') {
          // 공룡이 코스 위에서 AI를 물면 기수가 서서히 작아지며 사라집니다.
          const eating = Math.max(0, Math.min(1, 1 - dinoAttack.eatTimer / 1.65));
          const shrink = Math.max(.06, 1 - eating * .94);
          ctx.save();
          ctx.globalAlpha = 1 - eating * .35;
          ctx.translate(v.p.x, v.p.y);
          ctx.scale(shrink, shrink);
          ctx.translate(-v.p.x, -v.p.y);
          if (dinoAttack.phase === 'eat') {
            const shake = Math.sin(dinoAttack.elapsed * 46) * (1 - eating) * 4;
            ctx.translate(shake, 0);
          }
          drawRider(v.p, v.r.color, v.r.rider, v.r.name, false, raceTime * 9);
          ctx.restore();
        } else {
          drawRider(v.p, v.r.color, v.r.rider, v.r.name, false, raceTime * (v.r.sprinting ? 13 : 9) + v.r.z * .12);
          drawAiSkillEffects(v.r, camera, v.p);
        }
      });

      if (dinoAttack) {
        const dinoPoint = project(dinoAttack.x, dinoAttack.z, 0, camera);
        drawDinosaur(dinoPoint, dinoAttack, camera);
      }
    }
    if (!dimension.active || (loveTrainAttack && loveTrainAttack.phase === 'orbit')) {
      drawLoveTrainEffects(camera);
    }

    if (!firstPerson) {
      const pp = project(player.x, player.z, player.y, camera);
      drawRider(pp, '#70442b', '#e8c46f', '나', true, player.gaitTime);
    }
    drawRope(camera);
    drawSteelBall(camera);
    if (firstPerson) drawFirstPersonHorse();

    if (dimension.active) {
      // 화면 색을 차원 특유의 푸른 보라빛으로 살짝 물들입니다. 카메라는 평소처럼 플레이어를 따라갑니다.
      ctx.fillStyle = 'rgba(35,25,105,.19)'; ctx.fillRect(0, 0, W, H);
      const pulse = .5 + .5 * Math.sin(dimension.elapsed * 2.4);
      const aura = ctx.createRadialGradient(W * .5, H * .48, 20, W * .5, H * .48, Math.max(W, H) * .68);
      aura.addColorStop(0, `rgba(103,190,255,${.035 + pulse * .025})`);
      aura.addColorStop(1, 'rgba(25,14,77,.2)');
      ctx.fillStyle = aura; ctx.fillRect(0, 0, W, H);
    }

    // 화면 가장자리에 따뜻한 햇빛 느낌
    const vignette = ctx.createRadialGradient(W*.5,H*.5,Math.min(W,H)*.22,W*.5,H*.5,Math.max(W,H)*.72);
    vignette.addColorStop(.65,'rgba(48,27,9,0)'); vignette.addColorStop(1,'rgba(48,27,9,.2)');
    ctx.fillStyle = vignette; ctx.fillRect(0,0,W,H);
  }

  function frame(time) {
    const dt = Math.min(.05, (time - (lastTime || time)) / 1000 || 0);
    lastTime = time;
    update(dt);
    draw();
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  // 메뉴 화면의 기본 HUD 값도 보기 좋게 초기화합니다.
  updateHud();
})();
</script>
